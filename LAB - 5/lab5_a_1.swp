#!/bin/bash

echo "Choose any of below operation :-"
echo "1. Addition"
echo "2. Subtraction"
echo "3. Multiplication"
echo "4. Division"

echo -n "Enter your choice: "
read choice

echo -n "Enter first number: "
read a

echo -n "Enter second number: "
read b

if [ $choice -eq 1 ]; then
    result=$((a + b))
    echo "Addition = $result"
fi

if [ $choice -eq 2 ]; then
    result=$((a - b))
    echo "Subtraction = $result"
fi

if [ $choice -eq 3 ]; then
    result=$((a * b))
    echo "Multiplication = $result"
fi

if [ $choice -eq 4 ]; then
    if [ $b -eq 0 ]; then
        echo "Division by zero is not allowed"
    else
        result=$((a / b))
        echo "Division = $result"
    fi

if [ $choice -gt 4 ]; then
    echo "Invalid choice"
fi

